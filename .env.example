# --- Database ---
DATABASE_URL=postgresql+psycopg2://floatchat:floatchat@postgres:5432/floatchat
POSTGRES_USER=floatchat
POSTGRES_PASSWORD=floatchat
POSTGRES_DB=floatchat

# --- LLM / embeddings ---
LLM_PROVIDER=anthropic
LLM_API_KEY=your_api_key_here
LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
VECTOR_DB_PATH=./data/vectorstore
VECTOR_DB_BACKEND=chroma

# --- ARGO data source ---
ARGO_REGION=indian_ocean
ARGO_LOOKBACK_YEARS=3

# --- Voice (USP 4) ---
STT_PROVIDER=whisper
TTS_PROVIDER=none

# --- App ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEFAULT_MODE=citizen
DEFAULT_LANGUAGE=en